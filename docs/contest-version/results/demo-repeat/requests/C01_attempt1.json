        "claims": [
          {
            "claim_index": 1,
            "text": "《恢复计划示例（商业银行版）》将关键功能定义为：提供给第三方的关键业务或产品等金融服务，当这些金融服务出现突发中断时将带来严重影响，可能引发市场风险传染或恐慌；关键功能在恢复阶段应优先保护，确保持续提供服务，或按计划有序关闭。[7]",
            "role": "conclusion",
            "evidence_ids": [
              "[7]"
            ],

l": "农村商业银行"}, {"sheet_name": "商业银行分机构类情况表", "cell": "G5", "value": "8017.85054", "normalized_value": 8017.850540383, "unit": "亿元、%", "row_label": "一季度 / 不良贷款余额", "column_label": "农村商业银行"}, {"sheet_name": "商业银行分机构类情况表", "cell": "G7", "value": "4128.752793", "normalized_value": 4128.752792852, "unit": "亿元、%", "row_label": "一季度 / 可疑类贷款余额", "column_label": "农村商业银行"}, {"sheet_name": "商业银行分机构类情况表", "cell": "G6", "value": "3393.569718", "normalized_value": 3393.569717509, "unit": "亿元、%", "row_label": "一季度 / 次级类贷款余额", "column_label": "农村商业银行"}], "dynamic_table_evidence": true, "table_task": "compare", "operation": "max", "match_status": "valid_comparison", "refusal_reason": null, "selected_cell": {"coordinate": "G5", "row": 5, "column": 7, "row_label": "一季度 / 不良贷款余额", "column_label": "农村商业银行", "column_path": ["农村商业银行"], "value": "8017.85054", "normalized_value": 8017.850540383, "unit": "亿元、%", "is_formula": false, "formula": null}, "cell": "G5", "value": "8017.85054", "column_label": "农村商业银行", "evidence_id": "DOC-20260717-65EFE0BA259E-CHUNK-0002::G5", "aspect_id": "table_evidence", "aspect_question": "请联合核验制度文件与统计报表，但不要把行业汇总统计直接当作单一机构的合规结论。\n制度侧：根据《资本工具合格标准》，请说明与“其他一级资本工具没有到期日，并且”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。\n报表侧：根据 Excel 附件《2023年商业银行主要指标分机构类情况表（季度）》（工作表：商业银行分机构类情况表），在“农村商业银行”口径下，请比较“损失类贷款余额”、“不良贷款余额”、“可疑类贷款余额”、“次级类贷款余额”，找出数值最高的项目，并给出该项目名称、数值和单位。\n证据边界：仅凭上述两项材料能否直接认定某一家银行或保险机构合规？请说明理由。", "aspect_search_queries": [{"query": "请联合核验制度文件与统计报表，但不要把行业汇总统计直接当作单一机构的合规结论。\n制度侧：根据《资本工具合格标准》，请说明与“其他一级资本工具没有到期日，并且”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。\n报表侧：根据 Excel 附件《2023年商业银行主要指标分机构类情况表（季度）》（工作表：商业银行分机构类情况表），在“农村商业银行”口径下，请比较“损失类贷款余额”、“不良贷款余额”、“可疑类贷款余额”、“次级类贷款余额”，找出数值最高的项目，并给出该项目名称、数值和单位。\n证据边界：仅凭上述两项材料能否直接认定某一家银行或保险机构合规？请说明理由。", "query_type": "semantic_question", "rationale": "表格问题的自然语言意图"}, {"query": "2023年商业银行主要指标分机构类情况表（季度） 商业银行分机构类情况表", "query_type": "document_style_statement", "rationale": "接近表格标题和工作表名称"}, {"query": "2023年商业银行主要指标分机构类情况表（季度） 商业银行分机构类情况表 2023 农村商业银行", "query_type": "table_locator", "rationale": "表格结构定位锚点"}], "fusion_method": "structured_spreadsheet_retrieval", "expected_evidence_type": "表格工作表、行列标签、单元格坐标和值", "evidence_need": "表格工作表、行列标签、单元格坐标和值", "prompt_matched_aspects": ["table_evidence"]}}, {"document_id": "DOC-20260717-48611F1155BB", "chunk_id": "DOC-20260717-48611F1155BB-CHUNK-0004", "filename": "400_商业银行资本管理办法_附件1：资本工具合格标准.docx", "section_title": "二、其他一级资本工具的合格标准", "page_number": null, "excerpt": "（一）发行且实缴的。\n\n（二）受偿顺序排在存款人、一般债权人和次级债务之后。\n\n（三）发行银行或其关联机构不得提供抵押或保证，也不得通过其他安排使其相对于发行银行的债权人在法律或经济上享有优先受偿权。\n\n（四）没有到期日，并且不得含有利率跳升机制及其他赎回激励。\n\n（五）自发行之日起，至少5年后方可由发行银行赎回，但发行银行不得形成赎回权将被行使的预期，且行使赎回权前应经国家金融监督管理总局或其派出机构认可。\n\n（六）发行银行赎回其他一级资本工具，应符合以下要求：\n\n1.使用同等或更高质量的资本工具替换被赎回的工具，并且只有在收入能力具备可持续性的条件下才能实施资本工具的替换。\n\n2.或者，行使赎回权后的资本水平仍明显高于国家金融监督管理总局规定的监管资本要求。\n\n（七）资本工具发生本金偿付前，发行银行应经国家金融监督管理总局或其派出机构认可，并且不得假设或形成本金偿付将得到国家金融监督管理总局或其派出机构认可的市场预期。\n\n（八）任何情况下发行银行都有权取消资本工具的分红或派息，且不构成违约事件。发行银行可以自由支配取消的收益用于偿付其他到期债务。取消分红或派息除构成对普通股的收益分配限制以外，不得构成对发行银行的其他限制。\n\n（九）按照相关会计准则，若该工具被列为权益，须至少设定无法生存触发事件；若该工具被列为负债，须同时设定持续经营触发事件和无法生存触发事件。在满足以下最低合格标准的基础上，商业银行可根据市场情况和投资者意愿，在合同中自主设定更高标准。", "score": 0.9666667, "rerank_score": 0.9728823439906924, "chunk_type": "paragraph", "evidence_role": "direct_evidence", "metadata": {"document_id": "DOC-20260717-48611F1155BB", "page_number": null, "chunk_type": "paragraph", "evidence_role": "direct_evidence", "vector_score": 0.9666667, "rerank_score": 0.9728823439906924, "coverage_score": 0.46153846153846156, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-48611F1155BB-CHUNK-0003", "next_chunk_id": "DOC-20260717-48611F1155BB-CHUNK-0005", "source_title": "一、核心一级资本工具的合格标准", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "资本监管", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "400_商业银行资本管理办法_附件1：资本工具合格标准.docx", "source_format": "docx", "parser_version": "structured-v2", "loader_name": "python-docx", "block_count": 65, "file_type": "docx", "active_index_verified": true, "document_style_evidence_score": 0.0, "inferred_metadata_score": 0.0, "aspect_id": "regulatory_basis", "aspect_question": "根据《资本工具合格标准》，请说明与“其他一级资本工具没有到期日，并且”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《资本工具合格标准》，请说明与“其他一级资本工具没有到期日，并且”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "农村商业银行 填报说明 统计口径 适用范围 报送要求", "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明"}, {"query": "农村商业银行 定义 口径 要求", "query_type": "keyword_anchor", "rationale": "监管术语兜底"}], "aspect_search_query_hits": [{"query": "根据《资本工具合格标准》，请说明与“其他一级资本工具没有到期日，并且”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "rank": 2, "vector_score": 0.9666667, "query_type": "semantic_question", "rationale": "监管解释意图", "rrf_contribution": 0.016129}, {"query": "农村商业银行 填报说明 统计口径 适用范围 报送要求", "rank": 1, "vector_score": 0.6666667, "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明", "rrf_contribution": 0.018852}, {"query": "农村商业银行 定义 口径 要求", "rank": 3, "vector_score": 0.5, "query_type": "keyword_anchor", "rationale": "监管术语兜底", "rrf_contribution": 0.011905}], "aspect_query_fusion_score": 0.046886, "fusion_method": "aspect_query_rrf_then_bge_rerank", "expected_evidence_type": "监管制度中的指标定义、填报口径、适用范围和报送要求", "evidence_need": "监管制度中的指标定义、填报口径、适用范围和报送要求", "prompt_matched_aspects": ["regulatory_basis"]}}]}

重要信息系统突发事件。\n\n4.其他对经济金融安全、公共利益造成一般影响，或者对个人和组织权益造成较大影响的。", "score": 1.3, "rerank_score": 0.9886682464686385, "chunk_type": "paragraph", "evidence_role": "direct_evidence", "metadata": {"document_id": "DOC-20260717-904EFD39865B", "page_number": null, "chunk_type": "paragraph", "evidence_role": "direct_evidence", "vector_score": 1.3, "rerank_score": 0.9886682464686385, "coverage_score": 0.6521739130434783, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-904EFD39865B-CHUNK-0004", "next_chunk_id": "DOC-20260717-904EFD39865B-CHUNK-0006", "source_title": "国家金融监督管理总局关于印发银行保险机构数据安全管理办法的通知_附件：数据安全事件分级", "regulatory_topic": "消费者权益保护", "version_status": "unknown", "converted_from": "doc", "conversion_loader": "python-docx", "parser_backend": "libreoffice", "degraded": false, "conversion_elapsed_ms": 1884.1, "source_filename": "390_国家金融监督管理总局关于印发银行保险机构数据安全管理办法的通知_附件：数据安全事件分级.doc", "source_format": "doc", "parser_version": "structured-v2", "loader_name": "libreoffice-doc", "block_count": 24, "file_type": "doc", "active_index_verified": true, "document_style_evidence_score": 1.0, "inferred_metadata_score": 0.0, "aspect_id": "data_security_incident_classification", "aspect_question": "根据《数据安全事件分级》，请说明与“敏感级及以上数据遭到泄露、破坏或者非法获取、非法利用，对个人造成不可消除”、“银行保险机构自身部分业务无法正常开展或者本机构声誉受到破坏”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "《数据安全事件分级》中敏感级及以上数据遭到泄露、破坏或非法获取、非法利用对个人造成不可消除后果的认定标准", "query_type": "semantic_question", "rationale": "直接询问用户关注的条件、范围、期限或例外。"}, {"query": "敏感级及以上数据遭到泄露、破坏或者非法获取、非法利用，对个人造成不可消除", "query_type": "document_style_statement", "rationale": "近似用户引用原文，可能在制度中出现。"}, {"query": "数据安全事件分级 敏感级 不可消除 银行保险机构 部分业务无法正常开展 声誉破坏 条件 范围 期限 例外", "query_type": "keyword_anchor", "rationale": "综合关键词兜底。"}], "aspect_search_query_hits": [{"query": "《数据安全事件分级》中敏感级及以上数据遭到泄露、破坏或非法获取、非法利用对个人造成不可消除后果的认定标准", "rank": 1, "vector_score": 1.3, "query_type": "semantic_question", "rationale": "直接询问用户关注的条件、范围、期限或例外。", "rrf_contribution": 0.016393
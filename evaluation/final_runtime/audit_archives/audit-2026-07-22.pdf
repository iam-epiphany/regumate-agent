": 4, "vector_score": 0.5833334, "query_type": "document_style_statement", "rationale": "模仿方案原文可能出现的表述", "rrf_contribution": 0.017969}, {"query": "知识产权金融生态综合试点 工作方案 条件 范围 期限 例外", "rank": 2, "vector_score": 0.6666667, "query_type": "keyword_anchor", "rationale": "术语兜底，确保检索全面", "rrf_contribution": 0.012097}], "aspect_query_fusion_score": 0.045939, "fusion_method": "aspect_query_rrf_then_bge_rerank", "expected_evidence_type": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "evidence_need": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "prompt_matched_aspects": ["ip_finance_pilot_work"]}}, {"document_id": "DOC-20260717-1B1685F3896A", "chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0003", "filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "section_title": "二、总体目标", "page_number": 1, "excerpt": "持续强化政策引领、信贷支持、产业孵化、产品创新等发展 助推作用，充分发挥科技支撑、保险保障、专业处置等风险分担 和缓释作用。切实做好服务优化、人才培养、上下联动等基础保 障工作，推动知识产权质押融资年累放贷款金额合理增长，推动 知识产权金融迈上高质量发展新台阶，更好满足知识产权领域多 样化金融需求，助推社会经济高质量发展。\n\n到2027 年，试点地区基本建成服务便捷高效、信息共享畅 通、体制机制完备的知识产权金融生态综合试验区，结合各地实 际构建各具创新特色、运行良好高效的知识产权金融生态体系， 总体形成知识产权、产业、金融良性互动的工作局面。", "score": 0.6666667, "rerank_score": 0.9830200077626816, "chunk_type": "paragraph", "evidence_role": "related_context", "metadata": {"document_id": "DOC-20260717-1B1685F3896A", "page_number": 1, "chunk_type": "paragraph", "evidence_role": "related_context", "vector_score": 0.6666667, "rerank_score": 0.9830200077626816, "coverage_score": 0.3333333333333333, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0002", "next_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0004", "source_title": "知识产权金融生态综合试点工作方案", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "信贷管理", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "source_format": "pdf", "parser_version": "structured-v2", "loader_name": "pymupdf4llm", "block_count": 34, "file_type": "pdf", "active_index_verified": true, "document_style_evidence_score": 0.5, "inferred_metadata_score": 0.0, "aspect_id": "ip_finance_pilot_work", "aspect_question": "根据《知识产权金融生态综合试点工作方案》，请说明与“知识产权金融生态综合试点工作”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "知识产权金融生态综合试点工作方案中关于试点工作的条件、范围、期限和例外规定是什么", "query_type": "semantic_question", "rationale": "贴近用户意图，寻找明确规定"}, {"query": "知识产权金融生态综合试点工作 条件 范围 期限 例外 明确", "query_type": "document_style_statement", "rationale": "模仿方案原文可能出现的表述"}, {"query": "知识产权金融生态综合试点 工作方案 条件 范围 期限 例外", "query_type": "keyword_anchor", "rationale": "术语兜底，确保检索全面"}], "aspect_search_query_hits": [{"query": "知识产权金融生态综合试点工作方案中关于试点工作的条件、范围、期限和例外规定是什么", "rank": 4, "vector_score": 0.4166667, "query_type": "semantic_question", "rationale": "贴近用户意图，寻找明确规定", "rrf_contribution": 0.015625}, {"query": "知识产权金融生态综合试点工作 条件 范围 期限 例外 明确", "rank": 2, "vector_score": 0.6666667, "query_type": "document_style_statement", "rationale": "模仿方案原文可能出现的表述", "rrf_contribution": 0.018548}, {"query": "知识产权金融生态综合试点 工作方案 条件 范围 期限 例外", "rank": 4, "vector_score": 0.4166667, "query_type": "keyword_anchor", "rationale": "术语兜底，确保检索全面", "rrf_contribution": 0.011719}], "aspect_query_fusion_score": 0.045892, "fusion_method": "aspect_query_rrf_then_bge_rerank", "expected_evidence_type": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "evidence_need": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "prompt_matched_aspects": ["ip_finance_pilot_work"]}}, {"document_id": "DOC-20260717-1B1685F3896A", "chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0005", "filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "section_title": "三、重点任务", "page_number": 2, "excerpt": "（一）推进知识产权质押登记办理便捷高效\n\n1.全面推进质押登记线上办理。试验区内商业银行各分支机 构实现专利权质押登记全流程无纸化线上办理全覆盖。国家知识 产权局、国家版权局支持在试验区内设立商标权及版权质押登记 服务窗口或者代办点。国家版权局指导中国版权保护中心为试验 区金融机构开通版权质押登记绿色通道，加快建设在线版权质押 登记平台，优化登记流程，缩短办理周期。\n\n2.推进知识产权信息公示共享。推动建立版权质押登记公示 信息平台，完善版权质押登记机制。支持商标权和专利权质押登 记公告信息与中国人民银行征信中心动产融资统一登记系统共 享互通，进一步提升企业动产融资便利度。指导金融机构通过知 识产权保护信息平台、知识产权数据资源公共服务系统、中国及 多国专利查询系统、中国版权登记查询服务平台及各地版权登记 有关平台等系统，查询知识产权权属状态、许可使用、交易转让 等关键数据信息。鼓励试验区金融服务平台与知识产权相关机构 强化工作协同，在质押数据信息查询、融资需求、企业税务、市 场监管等方面加强信息共享，建立知识产权融资项目数据库，提 高信息获取便利度。\n\n（二）加强知识产权价值评估体系建设\n\n3.扩大推广知识产权价值内部评估。鼓励商业银行结合知识 产权价值评估标准及智能化评估模型工具，建立知识产权价值内 部评估体系。鼓励商业银行对于单笔1000 万元以下知识产权质 押贷款通过内部评估或者银企协商形式确定价值。指导商业银行 按照“边试点、边优化、边总结”原则，优化评估方法、指标、 系数，逐步扩大内部评估适用范围。", "score": 0.7, "rerank_score": 0.9399476313420319, "chunk_type": "paragraph", "evidence_role": "expanded_context", "metadata": {"document_id": "DOC-20260717-1B1685F3896A", "page_number": 2, "chunk_type": "paragraph", "evidence_role": "expanded_context", "vector_score": 0.7, "rerank_score": 0.9399476313420319, "coverage_score": 0.4166666666666667, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0004", "next_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0006", "version_status": "unknown", "source_title": "知识产权金融生态综合试点工作方案", "source_filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "file_sha256": "26570d3602983873bad603c9e7998cea87f90771b3e9c7620de607158c721ec6", "title": "知识产权金融生态综合试点工作方案", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "信贷管理", "business_domain": "风险管理", "source_type": "uploaded_file", "expansion_reason": "previous_chunk", "expanded_from_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0006", "aspect_id": "ip_finance_pilot_work", "aspect_question": "根据《知识产权金融生态综合试点工作方案》，请说明与“知识产权金融生态综合试点工作”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "知识产权金融生态综合试点工作方案中关于试点工作的条件、范围、期限和例外规定是什么", "query_type": "semantic_question", "rationale": "贴近用户意图，寻找明确规定"}, {"query": "知识产权金融生态综合试点工作 条件 范围 期限 例外 明确", "query_type": "document_style_statement", "rationale": "模仿方案原文可能出现的表述"}, {"query": "知识产权金融生态综合试点 工作方案 条件 范围 期限 例外", "query_type": "keyword_anchor", "rationale": "术语兜底，确保检索全面"}], "expected_evidence_type": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "evidence_need": "知识产权金融生态综合试点工作的定义、条件、范围、期限、例外等明确规定", "prompt_matched_aspects": ["ip_finance_pilot_work"]}}, {"document_id": "DOC-20260717-1B1685F3896A", "chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0007", "filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "section_title": "三、重点任务", "page_number": 2, "excerpt": "鼓励保险机构为知识产权创新企业提供综合保险方案， 全面开展知识产权转化运用类、海外维权类等保险业务。\n\n7.支持押品和模式创新。鼓励商业银行基于各类知识产权进 行组合质押融资。鼓励商业银行将动植物新品种权、地理标志、 集体商标、证明商标、数据权益等纳入可质押知识产权范畴，积 极探索围绕专利开放许可等促进知识产权转移转化的金融产品。 鼓励金融机构探索知识产权资产支持证券（ABS）、资产支持票 据（ABN）等业务模式，运用资本市场工具促进创新和成果转化。 鼓励信托公司开展知识产权信托，探索提供知识产权权益管理、 保护、代际传承、公益慈善等服务，实现知识产权安全保管和成 果转化后收益的高效管理。\n\n8.促进信贷资源盘活。鼓励商业银行通过银行业信贷资产登 记流转中心开展知识产权质押贷款直接转让、收益权转让等业 务。支持银行业信贷资产登记流转中心优化业务流程，为知识产 权质押贷款转让提供绿色通道服务，自本方案印发之日起三年内 对知识产权质押贷款转让免收各项费用。\n\n（四）健全知识产权交易机制\n\n9.发挥知识产权服务机构作用。鼓励各知识产权运营平台和 交易机构、中国版权保护中心、各国家级版权创新发展基地、各 版权贸易基地（交易中心）提高精准服务能力，为商业银行在产 品设计、模型优化、银企对接、押品筛选管理、权利风险控制等\n\n方面提供专业服务。鼓励知识产权服务机构发挥法律、技术等专 业作用，协助银行判断知识产权价值。", "score": 0.7, "rerank_score": 0.9399476313420319, "chunk_type": "paragraph", "evidence_role": "expanded_context", "metadata": {"document_id": "DOC-20260717-1B1685F3896A", "page_number": 2, "chunk_type": "paragraph", "evidence_role": "expanded_context", "vector_score": 0.7, "rerank_score": 0.9399476313420319, "coverage_score": 0.3333333333333333, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0006", "next_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0008", "version_status": "unknown", "source_title": "知识产权金融生态综合试点工作方案", "source_filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "file_sha256": "26570d3602983873bad603c9e7998cea87f90771b3e9c7620de607158c721ec6", "title": "知识产权金融生态综合试点工作方案", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "信贷管理", "business_domain": "风险管理", "source_type": "uploaded_file", "expansion_reason": "next_chunk", "expanded_from_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0006", "aspect_id": "ip_finance_pilot_work", "aspect_
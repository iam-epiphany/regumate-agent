 1.05, "rerank_score": 0.9523973431900807, "chunk_type": "paragraph", "evidence_role": "related_context", "metadata": {"document_id": "DOC-20260717-1B1685F3896A", "page_number": 6, "chunk_type": "paragraph", "evidence_role": "related_context", "vector_score": 1.05, "rerank_score": 0.9523973431900807, "coverage_score": 0.3333333333333333, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-1B1685F3896A-CHUNK-0010", "next_chunk_id": null, "source_title": "知识产权金融生态综合试点工作方案", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "信贷管理", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "386_国家金融监督管理总局_国家知识产权局_国家版权局关于印发《知识产权金融生态综合试点工作方案》的通知_知识产权金融生态综合试点工作方案.pdf", "source_format": "pdf", "parser_version": "structured-v2", "loader_name": "pymupdf4llm", "block_count": 34, "file_type": "pdf", "active_index_verified": true, "document_style_evidence_score": 0.0, "inferred_metadata_score": 0.0, "aspect_id": "regulatory_basis", "aspect_question": "根据《知识产权金融生态综合试点工作方案》，请说明与“知识产权金融生态综合试点工作”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《知识产权金融生态综合试点工作方案》，请说明与“知识产权金融生态综合试点工作”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "该统计指标 填报说明 统计口径 适用范围 报送要求", "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明"}, {"query": "该统计指标 定义 口径 要求", "query_type": "keyword_anchor", "rationale": "监管术语兜底"}], "aspect_search_query_hits": [{"query": "根据《知识产权金融生态综合试点工作方案》，请说明与“知识产权金融生态综合试点工作”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "rank": 1, "vector_score": 1.05, "query_type": "semantic_question", "rationale": "监管解释意图", "rrf_contribution": 0.016393}, {"query": "该统计指标 填报说明 统计口径 适用范围 报送要求", "rank": 2, "vector_score": 0.53333336, "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明", "rrf_contribution": 0.018548}, {"query": "该统计指标 定义 口径 要求", "rank": 1, "vector_score": 1.0, "query_type": "keyword_anchor", "rationale": "监管术语兜底", "rrf_contrib
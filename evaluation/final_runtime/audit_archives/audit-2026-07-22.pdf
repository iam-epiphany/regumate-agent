格TLAC1、TLAC2和TLAC3的披露要求于2025年起生效。\n\n三、披露表格", "score": 0.55, "rerank_score": 0.896975571673783, "chunk_type": "paragraph", "evidence_role": "related_context", "metadata": {"document_id": "DOC-20260717-B02120E573C8", "page_number": null, "chunk_type": "paragraph", "evidence_role": "related_context", "vector_score": 0.55, "rerank_score": 0.896975571673783, "coverage_score": 0.2222222222222222, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-B02120E573C8-CHUNK-0333", "next_chunk_id": "DOC-20260717-B02120E573C8-CHUNK-0335", "source_title": "商业银行信息披露内容和要求", "regulatory_topic": "资本监管", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "417_商业银行资本管理办法_附件22：商业银行信息披露内容和要求.docx", "source_format": "docx", "parser_version": "structured-v2", "loader_name": "python-docx", "block_count": 777, "file_type": "docx", "active_index_verified": true, "document_style_evidence_score": 0.0, "inferred_metadata_score": 0.0, "aspect_id": "regulatory_basis", "aspect_question": "根据《商业银行信息披露内容和要求》，请说明与“补充披露信息应符合真实性、准确性、完整性、一致性和可比性要求”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《商业银行信息披露内容和要求》，请说明与“补充披露信息应符合真实性、准确性、完整性、一致性和可比性要求”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "该统计指标 填报说明 统计口径 适用范围 报送要求", "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明"}, {"query": "该统计指标 定义 口径 要求", "query_type": "keyword_anchor", "rationale": "监管术语兜底"}], "aspect_search_query_hits": [{"query": "根据《商业银行信息披露内容和要求》，请说明与“补充披露信息应符合真实性、准确性、完整性、一致性和可比性要求”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "rank": 8, "vector_score": 0.55, "query_type": "semantic_question", "rationale": "监管解释意图", "rrf_contribution": 0.014706}, {"query": "该统计指标 填报说明 统计口径 适用范围 报送要求", "rank": 30, "vector_score": 0.0625, "query_type": "document_style_statement", "rationale": "接近制度正文和填报说明", "rrf_contribution": 0.012778}], "aspect_query_fusion_score": 0.027484, "fusion_method": "aspect_query_rr
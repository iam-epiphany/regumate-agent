684210527, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-7F0EA1F6AFCA-CHUNK-0029", "next_chunk_id": "DOC-20260717-7F0EA1F6AFCA-CHUNK-0031", "source_title": "银行保险机构恢复和处置计划实施暂行办法_附件3：处置计划建议示例（商业银行版）", "regulatory_topic": "资本监管", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "502_银行保险机构恢复和处置计划实施暂行办法_附件3：处置计划建议示例（商业银行版）.docx", "source_format": "docx", "parser_version": "structured-v2", "loader_name": "python-docx", "block_count": 77, "file_type": "docx", "active_index_verified": true, "document_style_evidence_score": 0.714286, "inferred_metadata_score": 0.333333, "aspect_id": "resolution_plan_funding_and_communication", "aspect_question": "根据《处置计划建议示例（商业银行版）》说明与“处置资金使用上应以使用金融机构自有资产或市场化渠道筹集资金开展自救为原则”及“处置计划沟通策略关注”相关的明确规定，包括条件、范围、期限或例外。", "aspect_search_queries": [{"query": "处置资金使用应以金融机构自有资产或市场化渠道筹集资金开展自救为原则的具体规定", "query_type": "semantic_question", "rationale": "贴近用户对资金原则的疑问"}, {"query": "处置计划沟通策略主要关注哪些方面", "query_type": "semantic_question", "rationale": "贴近用户对沟通策略的疑问"}, {"query": "处置计划建议示例（商业银行版） 处置资金 自有资产 市场化渠道 自救 原则 条件 例外", "query_type": "document_style_statement", "rationale": "模拟制度原文句式"}], "aspect_search_query_hits": [{"query": "处置资金使用应以金融机构自有资产或市场化渠道筹集资金开展自救为原则的具体规定", "rank": 1, "vector_score": 1.0, "query_type": "semantic_question", "rationale": "贴近用户对资金原则的疑问", "rrf_contribution": 0.016393}, {"query": "处置计划沟通策略主要关注哪些方面", "rank": 15, "vector_score": 0.13025211, "query_type": "semantic_question", "rationale": "贴近用户对沟通策略的疑问", "rrf_contribution": 0.013333}, {"query": "处置计划建议示例（商业银行版） 处置资金 自有资产 市场化渠道 自救 原则 条件 例外", "rank": 1, "vector_score": 1.0, "query_type": "document_style_statement", "rationale": "模拟制度原文句式", "rrf_contribution": 0.018852}], "aspect_query_fusion_score": 0.048579, "fusion_method": "aspect_query_rrf_then_bge_rerank", "expected_evidence_type": "找到《处置计划建议示例（商业银行版）》中关于处置资金来源原则（自有资产或市场化渠道自救）以及处置计划沟通策略关注点的具体条款，包括条件、范围、期限或例外。", "evidence_need": "找到《处置计划建议示例（商业银行版）》中关于处置资金来源原则（自有资产或市场化渠道自救
lumn_label": "2023年 / 一季度", "column_path": ["2023年", "一季度"], "value": "66289.49572", "normalized_value": 66289.495717422, "unit": "亿元", "is_formula": false, "formula": null}, "cell": "B5", "value": "66289.49572", "column_label": "2023年 / 一季度", "evidence_id": "DOC-20260717-B6D2A07BE07D-CHUNK-0002::B5", "aspect_id": "table_evidence", "aspect_question": "请联合核验制度文件与统计报表，但不要把行业汇总统计直接当作单一机构的合规结论。\n制度侧：根据《账簿划分和名词解释》，请说明与“商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变”、“除非产品性质发生变化，否则账簿转换不可撤销”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。\n报表侧：根据 Excel 附件《2023年银行业金融机构保障性安居工程贷款情况表(季度)》（工作表： 保障房贷款），在“年-季度”口径下，请比较“银行业金融机构合计”、“商业银行合计”、“大型商业银行”、“股份制商业银行”，找出数值最高的项目，并给出该项目名称、数值和单位。\n证据边界：仅凭上述两项材料能否直接认定某一家银行或保险机构合规？请说明理由。", "aspect_search_queries": [{"query": "根据 Excel 附件《2023年银行业金融机构保障性安居工程贷款情况表(季度)》（工作表： 保障房贷款），在“年-季度”口径下，请比较“银行业金融机构合计”、“商业银行合计”、“大型商业银行”、“股份制商业银行”，找出数值最高的项目，并给出该项目名称、数值和单位。", "query_type": "semantic_question", "rationale": "表格问题的自然语言意图"}, {"query": "2023年银行业金融机构保障性安居工程贷款情况表(季度) 保障房贷款", "query_type": "document_style_statement", "rationale": "接近表格标题和工作表名称"}, {"query": "2023年银行业金融机构保障性安居工程贷款情况表(季度) 保障房贷款 2023", "query_type": "table_locator", "rationale": "表格结构定位锚点"}], "fusion_method": "structured_spreadsheet_retrieval", "expected_evidence_type": "表格工作表、行列标签、单元格坐标和值", "evidence_need": "表格工作表、行列标签、单元格坐标和值", "prompt_matched_aspects": ["table_evidence"]}}, {"document_id": "DOC-20260717-F30D7E400A8C", "chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0017", "filename": "409_商业银行资本管理办法_附件13：账簿划分和名词解释.docx", "section_title": "三、账簿划分及转换的管理", "page_number": null, "excerpt": "（一）商业银行应当制定清晰的银行账簿和交易账簿划分政策和程序，明确纳入交易账簿的金融工具、外汇和商品头寸以及在银行账簿和交易账簿间转换的条件，定期评估执行情况，确保执行的一致性。\n\n（二）商业银行账簿转换应经高级管理层批准并经国家金融监督管理总局或其派出机构认可，不得以市场事件、金融工具流动性改变或单纯交易目的改变为由进行账簿转换，不得通过账簿转换进行监管套利。若因账簿转换导致资本计提要求下降，应将减少的资本部分重新加回。除非产品性质发生变化，否则账簿转换不可撤销。\n\n因会计准则变动引起的金融工具重新划分，商业银行应在获得高级管理层批准的情况下进行账簿转换。其中，从银行账簿到交易账簿的转换无需向国家金融监督管理总局或其派出机构申请。从交易账簿到银行账簿的转换需向国家金融监督管理总局或其派出机构申请。\n\n（三）商业银行应每年评估划分标准，如有更新应及时向国家金融监督管理总局或其派出机构报告。\n\n（四）商业银行应每年对划分政策和程序开展内部审计，内部审计结果需留档备查。", "score": 0.9782758620689656, "rerank_score": 0.9782758620689656, "chunk_type": "paragraph", "evidence_role": "exact_anchor_support", "metadata": {"document_id": "DOC-20260717-F30D7E400A8C", "page_number": null, "chunk_type": "paragraph", "evidence_role": "exact_anchor_support", "vector_score": 0.9782758620689656, "rerank_score": 0.9782758620689656, "coverage_score": 0.5714285714285714, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0016", "next_chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0018", "version_status": "unknown", "source_title": "一、交易账簿的范围及划分的标准", "source_filename": "409_商业银行资本管理办法_附件13：账簿划分和名词解释.docx", "file_sha256": "5fce86e6dd81bca629d749657b88676b52fc370db28908e1b36c595387b1919e", "title": "一、交易账簿的范围及划分的标准", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "资本监管", "business_domain": "风险管理", "source_type": "uploaded_file", "aspect_id": "regulatory_basis_1", "aspect_question": "根据《账簿划分和名词解释》，请说明与“商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变”相关的明确规定，并完整给出条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《账簿划分和名词解释》，请说明与“商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变”相关的明确规定，并完整给出条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "账簿划分和名词解释 商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变", "query_type": "document_style_statement", "rationale": "以指定材料和显式条件定位制度原文"}, {"query": "商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变", "query_type": "keyword_anchor", "rationale": "显式条件术语兜底"}], "expected_evidence_type": "监管制度中与“商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变”直接对应的条件、范围、期限或例外", "evidence_need": "监管制度中与“商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变”直接对应的条件、范围、期限或例外", "exact_support_anchor": "商业银行不得以市场事件、金融工具流动性改变或单纯交易目的改变", "exact_support_score": 1.9655, "fusion_method": "bounded_document_exact_anchor", "prompt_matched_aspects": ["regulatory_basis_1"]}}, {"document_id": "DOC-20260717-F30D7E400A8C", "chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0011", "filename": "409_商业银行资本管理办法_附件13：账簿划分和名词解释.docx", "section_title": "一、交易账簿的范围及划分的标准", "page_number": null, "excerpt": "1.会计准则下，以交易性目的而持有的金融资产或承担的金融负债。2.因做市业务而持有的工具。\n\n3.上市权益工具。其中，因可转换债券、债转股、抵债资产、未上市股权等原因形成的非交易目的的上市权益工具，可不适用推定原则，但应书面说明依据并留档备查；其他形式的非交易目的的上市权益工具，应在经国家金融监督管理总局认可后方可划入银行账簿。", "score": 0.9666667, "rerank_score": 0.9809855660757951, "chunk_type": "paragraph", "evidence_role": "related_context", "metadata": {"document_id": "DOC-20260717-F30D7E400A8C", "page_number": null, "chunk_type": "paragraph", "evidence_role": "related_context", "vector_score": 0.9666667, "rerank_score": 0.9809855660757951, "coverage_score": 0.25, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0010", "next_chunk_id": "DOC-20260717-F30D7E400A8C-CHUNK-0012", "source_title": "一、交易账簿的范围及划分的标准", "issuing_authority": "国家金融监督管理总局", "regulatory_topic": "资本监管", "business_domain": "风险管理", "version_status": "unknown", "source_filename": "409_商业银行资本管理办法_附件13：账簿划分和名词解释.docx", "source_format": "docx", "parser_version": "structured-v2", "loader_name": "python-docx", "block_count": 93, "file_type": "docx", "active_index_verified": true, "document_style_evidence_score": 0.333333, "inferred_metadata_score": 0.0, "aspect_id": "regulatory_basis_2", "aspect_question": "根据《账簿划分和名词解释》，请说明与“除非产品性质发生变化，否则账簿转换不可撤销”相关的明确规定，并完整给出条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《账簿划分和名词解释》，请说明与“除非产品性质发生变化，否则账簿转换不可撤销”相关的明确规定，并完整给出条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "账簿划分和名词解释 除非产品性质发生变化，否则账簿转换不可撤销", "query_type": "document_style_statement", "rationale": "以指定材料和显式条件定位制度原文"}, {"query": "除非产品性质发生变化，否则账簿转换不可撤销", "query_type": "keyword_anchor", "rationale": "显式条件术语兜底"}], "aspect_search_query_hits": [{"query": "根据《账簿划分和名词解释》，请说明与“除非产品性质发生变化，否则账簿转换不可撤销”相关的明确规定，并完整给出条件、范围、期限或例外。", "rank": 2, "vector_score": 0.9666667, "query_type": "semantic_question", "rationale": "监管解释意图", "rrf_contribution": 0.016129}, {"query": "账簿划分和名词解释 除非产品性质发生变化，否则账簿转换不可撤销", "rank": 2, "vector_score": 0.45, "query_type": "do
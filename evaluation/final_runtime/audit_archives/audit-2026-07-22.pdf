0", "page_number": null, "chunk_type": "paragraph", "evidence_role": "expanded_context", "vector_score": 0.98, "rerank_score": 0.9299999999999999, "coverage_score": 0.36363636363636365, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-53479103A190-CHUNK-0019", "next_chunk_id": "DOC-20260717-53479103A190-CHUNK-0021", "version_status": "unknown", "title": "消费金融公司管理办法_消费金融公司管理办法", "issuing_authority": "国家金融监督管理总局", "effective_date": "2024-04-18", "regulatory_topic": "资本监管", "business_domain": "风险管理", "source_type": "uploaded_file", "source_title": "消费金融公司管理办法_消费金融公司管理办法", "source_filename": "396_消费金融公司管理办法_消费金融公司管理办法.doc", "file_sha256": "923d95dcab10aaa10eacae8fd0f365b10d5d09fb88f1cd58744232a6c4e69991", "expansion_reason": "previous_chunk", "expanded_from_chunk_id": "DOC-20260717-53479103A190-CHUNK-0021", "aspect_id": "consumption_finance_can", "aspect_question": "根据《消费金融公司管理办法》，请说明与“消费金融公司可以”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "消费金融公司管理办法 消费金融公司可以 明确规定 条件 范围 期限 例外", "query_type": "semantic_question", "rationale": "贴近用户意图，综合关键词搜索相关条款。"}, {"query": "消费金融公司可以经营下列部分或者全部人民币业务", "query_type": "document_style_statement", "rationale": "模仿制度原文表述，提高命中准确率。"}, {"query": "消费金融公司 可以 业务范围 条件 期限 例外", "query_type": "keyword_anchor", "rationale": "使用核心术语兜底检索。"}], "expected_evidence_type": "找到《消费金融公司管理办法》中与‘消费金融公司可以’相关的条款，包括允许的业务范围、条件、期限、例外等具体规定。", "evidence_need": "找到《消费金融公司管理办法》中与‘消费金融公司可以’相关的条款，包括允许的业务范围、条件、期限、例外等具体规定。", "prompt_matched_aspects": ["consumption_finance_can"]}}, {"document_id": "DOC-20260717-53479103A190", "chunk_id": "DOC-20260717-53479103A190-CHUNK-0022", "filename": "396_消费金融公司管理办法_消费金融公司管理办法.doc", "section_title": null, "page_number": null, "excerpt": "第十六条 经营状况良好、符合条件的消费金融公司，可以向国家金融监督管理总局及其派出机构申请经营下列部分或者全部人民币业务：\n\n（一）资产证券化业务；\n\n（二）固定收益类证券投资业务；\n\n（三）国家金融监督管理总局批准的其他业务。\n\n消费金融公司申请开办前款所列业务的具体条件和程序，按照行政许可有关规定执行。\n\n第十七条 符合条件的消费金融公司可以申请发行资本工具，并应当符合监管要求的相关合格标准。\n\n第十八条 消费金融公司向借款人发放消费贷款，应当审慎评估借款人的还款能力，对借款人贷款授信额度最高不得超过人民币20万元。\n\n第十九条 消费金融公司应当构建欺诈风险防控体系，通过完善反欺诈模型与相关技术手段，有效识别欺诈行为，确保借款人身份数据与借款意愿真实有效，保障信贷资金安全。\n\n第二十条 消费金融公司应当遵循利率市场化原则，建立消费贷款利率的风险定价机制，遵循依法合规、审慎经营、平等自愿、公平诚信的原则，合理确定消费贷款的利率水平。\n\n第二十一条 消费金融公司开展互联网贷款业务，应当遵守互联网贷款有关法律法规和监管规定。", "score": 0.98, "rerank_score": 0.9299999999999999, "chunk_type": "paragraph", "evidence_role": "expanded_context", "metadata": {"document_id": "DOC-20260717-53479103A190", "page_number": null, "chunk_type": "paragraph", "evidence_role": "expanded_context", "vector_score": 0.98, "rerank_score": 0.9299999999999999, "coverage_score": 0.2727272727272727, "section_number": null, "parent_section_number": null, "previous_chunk_id": "DOC-20260717-53479103A190-CHUNK-0021", "next_chunk_id": "DOC-20260717-53479103A190-CHUNK-0023", "version_status": "unknown", "title": "消费金融公司管理办法_消费金融公司管理办法", "issuing_authority": "国家金融监督管理总局", "effective_date": "2024-04-18", "regulatory_topic": "资本监管", "business_domain": "风险管理", "source_type": "uploaded_file", "source_title": "消费金融公司管理办法_消费金融公司管理办法", "source_filename": "396_消费金融公司管理办法_消费金融公司管理办法.doc", "file_sha256": "923d95dcab10aaa10eacae8fd0f365b10d5d09fb88f1cd58744232a6c4e69991", "expansion_reason": "next_chunk", "expanded_from_chunk_id": "DOC-20260717-53479103A190-CHUNK-0021", "aspect_id": "consumption_finance_can", "aspect_question": "根据《消费金融公司管理办法》，请说明与“消费金融公司可以”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "消费金融公司管理办法 消费金融公司可以 明确规定 条件 范围 期限 例外", "query_type": "semantic_question", "rationale": "贴近用户意图，综合关键词搜索相关条款。"}, {"query": "消费金融公司可以经营下列部分或者全部人民币业务", "query_type": "document_style_statement", "rationale": "模仿制度原文表述，提高命中准确率。"}, {"query": "消费金融公司 可以 业务范围 条件 期限 例外", "query_type": "keyword_anchor", "rationale": "使用核心术语兜底检索。"}], "expected_evidence_type": "找到《消费金融公司管理办法》中与‘消费金融公司可以’相关的条款，包括允许的业务范围、条件、期限、例外等具体规定。", "evidence_need": "找到《消费金融公司管理办法》中与‘消费金融公司可以’相关的条款，包括允许的业务范围、条件、期限、例外等具体规定。", "prompt_matched_aspects": ["consumption_finance_can"]}}]}

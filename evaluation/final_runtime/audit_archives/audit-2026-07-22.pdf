evidence_id": "DOC-20260717-A5A490110294-CHUNK-0002::C4", "aspect_id": "table_evidence", "aspect_question": "请联合核验制度文件与统计报表，但不要把行业汇总统计直接当作单一机构的合规结论。\n制度侧：根据《寿险合同负债评估折现率曲线》，请说明与“万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。\n报表侧：根据 Excel 附件《2023年10月全国各地区原保险保费收入情况表》（工作表：各地区数据（月度）），“全国合计”在“合计”口径下的数值是多少？\n证据边界：仅凭上述两项材料能否直接认定某一家银行或保险机构合规？请说明理由。", "aspect_search_queries": [{"query": "根据 Excel 附件《2023年10月全国各地区原保险保费收入情况表》（工作表：各地区数据（月度）），“全国合计”在“合计”口径下的数值是多少？", "query_type": "semantic_question", "rationale": "表格问题的自然语言意图"}, {"query": "2023年10月全国各地区原保险保费收入情况表 各地区数据（月度） 全国合计", "query_type": "document_style_statement", "rationale": "接近表格标题和工作表名称"}, {"query": "2023年10月全国各地区原保险保费收入情况表 各地区数据（月度） 2023 10 全国合计 合计 全国合计", "query_type": "table_locator", "rationale": "表格结构定位锚点"}], "fusion_method": "structured_spreadsheet_retrieval", "expected_evidence_type": "表格工作表、行列标签、单元格坐标和值", "evidence_need": "表格工作表、行列标签、单元格坐标和值", "prompt_matched_aspects": ["table_evidence"]}}, {"document_id": "DOC-20260717-A9882638B9C6", "chunk_id": "DOC-20260717-A9882638B9C6-CHUNK-0001", "filename": "460_中国银保监会关于实施_保险公司偿付能力监管规则（Ⅱ）_有关事项的通知_附件1：寿险合同负债评估的折现率曲线.pdf", "section_title": "寿险合同负债评估折现率曲线", "page_number": 1, "excerpt": "根据《保险公司偿付能力监管规则第3 号：寿险合同 负债评估》第十九条规定，计算现金流现值所采用的折现 率曲线由基础利率曲线加综合溢价形成，具体计算方法如 下：\n\n一、基础利率曲线为即期曲线，由以下三段组成: 750 日移动平均国债收益率曲线 0 < �≤20 终极利率过渡曲线 20 < �≤40 终极利率 t > 40\n\n其中，t 表示年度；750 日移动平均国债收益率曲线详 见中国债券信息网（www.chinabond.com.cn）；终极利率 过渡曲线采用二次插值方法计算得到；终极利率暂定为 4.5%。\n\n二、终极利率过渡曲线采用二次插值方法计算得到， 具体如下：\n\n（一）第一次插值的计算公式为：\n\nrt=r20+（4.5%-r20）×（t-20）/（40-20） 其中：\n\nt 为年度；\n\n- r t 为在t 年度第一次插值的数值。\n\n- （二）第二次插值的计算公式为：\n\n- Rt=rt×（t-20）/（40-20）+r*t<sup>×（40-t）/（40-20）</sup> 其中：\n\n- t 为年度；\n\n- r t 为在t 年度第一次插值的数值；\n\n-\n\n- r t<sup>为在t 年度750 天移动平均国债收益率曲线的数值；</sup>\n\n- Rt 为在t 年度终极利率过渡曲线的数值。 三、综合溢价按以下规则确定：\n\n- （一）前20 年的综合溢价根据业务类型等因素分档设\n\n- 定：一是1999 年（含）之前签发的高利率保单适用75BP 溢价；二是万能险、投资连结险、变额年金及中短存续期 产品适用30BP 溢价；三是其他产品适用45BP 溢价。\n\n- （二）40 年以后的终极利率综合溢价为0。\n\n- （三）20 年到40 年之间的综合溢价采用以下线性插\n\n- 值法得到：\n\nSpreadt=Spread20×（40-t）/（40-20） 其中：\n\nt 为年度，20 < �≤40；\n\nSpreadt 为在t 年度第一次插值的数值。 四、折现率曲线的换算\n\n保险公司按照本附件规定的即期基础利率曲线附加综 合溢价，得到即期折现率曲线。保险合同负债评估中所使 用的远期折现率曲线，由即期折现率曲线换算得到。", "score": 0.9783870967741936, "rerank_score": 0.9783870967741936, "chunk_type": "paragraph", "evidence_role": "exact_anchor_support", "metadata": {"document_id": "DOC-20260717-A9882638B9C6", "page_number": 1, "chunk_type": "paragraph", "evidence_role": "exact_anchor_support", "vector_score": 0.9783870967741936, "rerank_score": 0.9783870967741936, "coverage_score": 1.0, "section_number": null, "parent_section_number": null, "previous_chunk_id": null, "next_chunk_id": null, "version_status": "unknown", "source_title": "寿险合同负债评估折现率曲线", "source_filename": "460_中国银保监会关于实施_保险公司偿付能力监管规则（Ⅱ）_有关事项的通知_附件1：寿险合同负债评估的折现率曲线.pdf", "file_sha256": "8c3f80730cc6abb3a4a6c56087c9fd8763cfd3736274c3a22114e7ece0fe9ff5", "title": "寿险合同负债评估折现率曲线", "source_type": "uploaded_file", "aspect_id": "regulatory_basis", "aspect_question": "根据《寿险合同负债评估折现率曲线》，请说明与“万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "根据《寿险合同负债评估折现率曲线》，请说明与“万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价”相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "query_type": "semantic_question", "rationale": "监管解释意图"}, {"query": "寿险合同负债评估折现率曲线 万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价", "query_type": "document_style_statement", "rationale": "以指定材料和显式条件定位制度原文"}, {"query": "万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价", "query_type": "keyword_anchor", "rationale": "显式条件术语兜底"}], "expected_evidence_type": "监管制度中与“万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价”直接对应的条件、范围、期限或例外", "evidence_need": "监管制度中与“万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价”直接对应的条件、范围、期限或例外", "exact_support_anchor": "万能险、投资连结险、变额年金及中短存续期产品适用30BP综合溢价", "exact_support_score": 1.9677, "fusion_method": "bounded_document_exact_anchor", "prompt_matched_aspects": ["regulatory_basis"]}}]}

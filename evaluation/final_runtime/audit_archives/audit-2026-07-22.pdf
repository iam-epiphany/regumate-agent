_section_number": null, "previous_chunk_id": "DOC-20260717-B02120E573C8-CHUNK-0005", "next_chunk_id": "DOC-20260717-B02120E573C8-CHUNK-0007", "version_status": "unknown", "source_title": "商业银行信息披露内容和要求", "source_filename": "417_商业银行资本管理办法_附件22：商业银行信息披露内容和要求.docx", "file_sha256": "119e4d24da0fd5d6eaebdc32e2a8363619d7d87ac55f404a9192d930860ee953", "title": "商业银行信息披露内容和要求", "regulatory_topic": "资本监管", "business_domain": "风险管理", "source_type": "uploaded_file", "expansion_reason": "previous_chunk", "expanded_from_chunk_id": "DOC-20260717-B02120E573C8-CHUNK-0007", "aspect_id": "disclosure_table_requirements", "aspect_question": "根据《商业银行信息披露内容和要求》，请说明与'商业银行应根据表格要求，分别'相关的明确规定。请完整给出材料明确写明的条件、范围、期限或例外。", "aspect_search_queries": [{"query": "商业银行应根据表格要求分别 条件 范围 期限 例外", "query_type": "semantic_question", "rationale": "贴近用户意图，检索相关条件、范围、期限或例外。"}, {"query": "商业银行信息披露内容和要求 表格要求 分别 规定", "query_type": "document_style_statement", "rationale": "模仿制度原文标题或证据句，提高命中率。"}, {"query": "信息披露 表格 分别 商业银行", "query_type": "keyword_anchor", "rationale": "使用关键术语兜底，防止遗漏。"}], "expected_evidence_type": "找到《商业银行信息披露内容和要求》中关于'应根据表格要求，分别'的条款、条件、范围、期限或例外规定。", "evidence_need": "找到《商业银行信息披露内容和要求》中关于'应根据表格要求，分别'的条款、条件、范围、期限或例外规定。", "prompt_matched_aspects": ["disclosure_table_requirements"]}}]}

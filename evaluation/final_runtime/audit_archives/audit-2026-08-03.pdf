evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "accident_insurance_expense_rate_regulation", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "预定附加费用率意外险产品定价", "exact_support_score": 0.7692}}]}

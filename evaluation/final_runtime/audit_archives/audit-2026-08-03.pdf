设 定，但平均附加费用率不得超过下表规定的上限。平均附加 费用率是指保单各期预定附加费用精算现值之和占保单毛 保费精算现值之和的比例。 2", "score": 0.9184615384615384, "rerank_score": 0.9184615384615384, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "accident_insurance_extra_expense_rate_regulation", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "意外险产品预定附加费用率设定", "exact_support_score": 0.7692}}]}

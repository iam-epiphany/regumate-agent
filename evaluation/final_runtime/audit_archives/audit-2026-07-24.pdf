 "rerank_score": 0.9369387755102041, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "pillar3_table_type", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "商业银行以表格形式进行第三支柱信息披露包括固定表格和可变表格按照监管并表范围披露表格中另有规定的除外", "exact_support_score": 1.1388}}]}

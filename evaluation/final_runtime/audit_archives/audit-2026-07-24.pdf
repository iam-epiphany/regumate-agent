, "rerank_score": 0.9314285714285715, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "accidental_injury_insurance_regulation_2", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "意外伤害保险业务监管办法 保单信息查询服务应至少保留至保险责任结束后三个月", "exact_support_score": 1.0286}}]}

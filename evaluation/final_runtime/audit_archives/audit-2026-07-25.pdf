0952380952381, "rerank_score": 0.9180952380952381, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "digital_confirmation_effectiveness", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "银行业金融机构收到符合规定的询证函后多久回函", "exact_support_score": 0.7619}}]}

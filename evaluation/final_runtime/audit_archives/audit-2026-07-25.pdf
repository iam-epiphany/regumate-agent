909, "rerank_score": 0.9209090909090909, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "ip_finance_eco_2027_goal", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "特别重大数据事件省级区域", "exact_support_score": 0.8182}}]}

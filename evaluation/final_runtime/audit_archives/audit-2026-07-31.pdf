具体事项予以进一步明确和细化，以推进会计师事务所和银行业金融机构提高银行函证工作质量和效率。", "score": 0.93, "rerank_score": 0.88, "chunk_type": "paragraph", "evidence_role": "mcq_exact_support", "metadata": {"aspect_id": "multiple_choice_evidence", "fusion_method": "mcq_exact_support_early_stop", "exact_support_score": 1.0}}]}

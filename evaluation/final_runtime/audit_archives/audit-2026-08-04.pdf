": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "consumer_finance_single_borrower_credit_limit", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "消费贷款授信额度上限", "exact_support_score": 0.7778}}]}

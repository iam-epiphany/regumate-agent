t_id": "DOC-20260717-53479103A190", "chunk_id": "DOC-20260717-53479103A190-CHUNK-0004", "filename": "396_消费金融公司管理办法_消费金融公司管理办法.doc", "section_title": null, "page_number": null, "excerpt": "未经国家金融监督管理总局批准，任何机构不得在名称中使用“消费金融”字样。第五条 国家金融监督管理总局及其派出机构依法对消费金融公司实施监督管理。 第二章 设立与变更", "score": 0.98, "rerank_score": 0.9299999999999999, "chunk_type": "paragraph", "evidence_role": "expanded_context", "metadata": {"aspect_id": "cfc_name_label_approval"}}]}

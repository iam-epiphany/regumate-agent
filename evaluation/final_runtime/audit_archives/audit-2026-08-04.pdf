ore": 0.9254545454545454, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "aspect_1", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "核心一级资本工具的抵押或", "exact_support_score": 0.9091}}]}

契合程度及其他影响机构价值的因素，识别核心业务条线。", "score": 0.9475, "rerank_score": 0.9475, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "critical_shared_service_definition", "fusion_method": "bounded_document_condition_continuation", "exact_support_anchor": "关键共享服务", "exact_support_score": 1.35}}]}

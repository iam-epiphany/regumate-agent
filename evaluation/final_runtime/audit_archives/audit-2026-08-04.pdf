ank_score": 0.9216666666666666, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "group_level_margin_threshold", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "保证金起点金额", "exact_support_score": 0.8333}}]}

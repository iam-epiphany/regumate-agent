_role": "bounded_lexical_support", "metadata": {"aspect_id": "multiple_external_ratings_usage", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "同一信用主体或债项存在多个外部评级结果时，商业银行应如何使用", "exact_support_score": 0.7857}}]}

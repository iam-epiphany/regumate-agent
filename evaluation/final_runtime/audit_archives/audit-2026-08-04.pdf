ore": 0.9188888888888889, "rerank_score": 0.9188888888888889, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "core_tier1_capital_tool_collateral_guarantee_prohibition", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "核心一级资本抵押保证", "exact_support_score": 0.7778}}]}

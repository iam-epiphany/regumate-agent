615384615384, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "bank_letter_confirmation_methods", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "银行询证函的函证方式包括哪些", "exact_support_score": 0.7692}}]}

0909, "rerank_score": 0.9209090909090909, "chunk_type": "paragraph", "evidence_role": "bounded_lexical_support", "metadata": {"aspect_id": "aspect_1", "fusion_method": "bounded_document_lexical_support", "exact_support_anchor": "列示的主要金融产品和服务", "exact_support_score": 0.8182}}]}

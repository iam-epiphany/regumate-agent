# Copy to .env and fill in your own LLM credentials.
# This template contains no real keys. Docker Compose reads these settings.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_RESPONSE_FORMAT=json_object

# Service ports on the deployment machine.
REGUMATE_APP_PORT=8000
REGUMATE_QDRANT_HTTP_PORT=6333
REGUMATE_QDRANT_GRPC_PORT=6334

# GPU defaults. CPU deployments: set cpu, cpu and regumate/app:contest-cpu.
REGUMATE_TORCH_FLAVOR=cuda
MODEL_DEVICE=cuda
REGUMATE_APP_IMAGE=regumate/app:contest-v3
MODEL_BACKEND=pytorch
MODEL_WARMUP_POLICY=background

# Local retrieval models. Blank hints allow automatic path resolution.
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
REGUMATE_OFFLINE_MODE=false
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

# Vector collection and upload limit (bytes).
QDRANT_COLLECTION=regumate_chunks
QDRANT_AUTO_CREATE_COLLECTION=true
MAX_UPLOAD_BYTES=52428800

# Optional outbound proxy. Blank means direct network access.
REGUMATE_HTTP_PROXY=
REGUMATE_HTTPS_PROXY=
REGUMATE_NO_PROXY=localhost,127.0.0.1,qdrant,::1
